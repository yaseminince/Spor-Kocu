@page
@model Sporkocu.Web.Pages.Answer.DeleteModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Cevabı Sil";
}

<div class="container py-5">

    <div class="delete-card">

        <div class="delete-icon">
            🗑️
        </div>

        <h2 class="fw-bold mt-3">
            Cevabı Sil
        </h2>

        <p class="text-muted">
            Bu cevabı silmek istediğinizden emin misiniz?
        </p>


        <div class="answer-preview">
            @Model.Answer.Description
        </div>


        <form method="post">

            <input type="hidden"
                   name="id"
                   value="@Model.Answer.Id" />

            <input type="hidden"
                   name="mode"
                   value="admin" />


            <div class="d-flex justify-content-center gap-2 mt-4">

                <a href="/Answer/List?mode=admin"
                   class="btn btn-outline-secondary">
                    Vazgeç
                </a>

                <button type="submit"
                        class="btn btn-danger">
                    Evet, Sil
                </button>

            </div>

        </form>

    </div>

</div>


<style>

    .delete-card {
        max-width: 600px;
        margin: 50px auto;
        background: white;
        border: 1px solid #e4ebe7;
        border-radius: 18px;
        padding: 45px;
        text-align: center;
        box-shadow: 0 5px 20px rgba(0,0,0,.04);
    }

    .delete-icon {
        font-size: 40px;
    }

    .answer-preview {
        background: #f8faf9;
        border-left: 4px solid #198754;
        border-radius: 10px;
        padding: 20px;
        text-align: left;
        color: #45524a;
        line-height: 1.6;
    }

</style>