@page
@model Sporkocu.Web.Pages.Exercise.DeleteModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Egzersiz Sil";
}

<div class="container py-5">

    <div class="delete-wrapper">

        <div class="delete-icon">
            🗑️
        </div>

        <h1 class="fw-bold mt-4 mb-3">
            Egzersizi Sil
        </h1>

        <p class="text-muted">
            Bu egzersizi silmek istediğinize emin misiniz?
        </p>

        <div class="exercise-preview">

            @if (!string.IsNullOrWhiteSpace(Model.Exercise.ImagePath))
            {
                <img src="@Model.Exercise.ImagePath"
                     class="preview-image"
                     alt="@Model.Exercise.Title" />
            }
            else
            {
                <div class="preview-placeholder">
                    🏋️
                </div>
            }

            <div class="preview-content">

                <h4 class="fw-bold mb-2">
                    @Model.Exercise.Title
                </h4>

                @if (!string.IsNullOrWhiteSpace(Model.Exercise.Description))
                {
                    <p class="text-muted mb-0">
                        @Model.Exercise.Description
                    </p>
                }

            </div>

        </div>

        <form method="post">

            <input type="hidden"
                   name="mode"
                   value="admin" />

            <div class="d-flex justify-content-center gap-3 mt-4">

                <a href="/Exercise/List?mode=admin"
                   class="btn btn-light border px-4">
                    Vazgeç
                </a>

                <button type="submit"
                        class="btn btn-danger px-4">
                    Egzersizi Sil
                </button>

            </div>

        </form>

    </div>

</div>

<style>

    .delete-wrapper {
        width: 650px;
        margin: 50px auto;
        background: white;
        border: 1px solid #e5e9e7;
        border-radius: 20px;
        padding: 40px;
        text-align: center;
        box-shadow: 0 6px 25px rgba(0,0,0,.05);
    }

    .delete-icon {
        width: 65px;
        height: 65px;
        margin: auto;
        border-radius: 50%;
        background: #fff0f0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
    }

    .exercise-preview {
        margin-top: 25px;
        padding: 15px;
        background: #f8faf9;
        border-radius: 14px;
        display: flex;
        align-items: center;
        gap: 18px;
        text-align: left;
    }

    .preview-image,
    .preview-placeholder {
        width: 100px;
        height: 80px;
        border-radius: 10px;
        object-fit: cover;
        flex-shrink: 0;
    }

    .preview-placeholder {
        background: #e8f5ee;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
    }

    .preview-content {
        flex: 1;
    }

</style>