@page
@model Sporkocu.Web.Pages.Exercise.ListModel

@{
    Layout = Model.IsAdmin ? "_AdminLayout" : "_UserLayout";
    ViewData["Title"] = "Egzersizler";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-5">

        <div>
            <span class="page-badge">SPORKOCU</span>

            <h1 class="fw-bold mt-3 mb-2">
                Egzersizler
            </h1>

            <p class="text-muted mb-0">
                Egzersizleri inceleyin ve hareketler hakkında bilgi edinin.
            </p>
        </div>

        @if (Model.IsAdmin)
        {
            <a href="/Exercise/Create?mode=admin"
               class="btn btn-success px-4">
                + Yeni Egzersiz
            </a>
        }

    </div>

    @if (!Model.Exercises.Any())
    {
        <div class="empty-card">

            <div class="empty-icon">
                🏋️
            </div>

            <h4 class="fw-bold mt-3">
                Henüz egzersiz bulunmuyor.
            </h4>

            @if (Model.IsAdmin)
            {
                <p class="text-muted mb-0">
                    Yeni bir egzersiz ekleyerek başlayabilirsiniz.
                </p>
            }
            else
            {
                <p class="text-muted mb-0">
                    Egzersizler eklendiğinde burada görüntüleyebilirsiniz.
                </p>
            }

        </div>
    }
    else
    {
        <div class="exercise-grid">

            @foreach (var exercise in Model.Exercises)
            {
                <div class="exercise-card">

                    @if (!string.IsNullOrWhiteSpace(exercise.ImagePath))
                    {
                        <img src="@exercise.ImagePath"
                             class="exercise-image"
                             alt="@exercise.Title" />
                    }
                    else
                    {
                        <div class="exercise-placeholder">
                            🏋️
                        </div>
                    }

                    <div class="exercise-body">

                        <div class="exercise-title-row">

                            <h3 class="fw-bold mb-2">
                                @exercise.Title
                            </h3>

                        </div>

                        @if (!string.IsNullOrWhiteSpace(exercise.Description))
                        {
                            <p class="text-muted exercise-description">
                                @exercise.Description
                            </p>
                        }

                        @if (exercise.Category != null)
                        {
                            <span class="category-badge">
                                @exercise.Category.Title
                            </span>
                        }

                        @if (!string.IsNullOrWhiteSpace(exercise.VideoLinkPath))
                        {
                            <div class="mt-3">
                                <a href="@exercise.VideoLinkPath"
                                   target="_blank"
                                   class="video-link">
                                    ▶ Video İzle
                                </a>
                            </div>
                        }

                        @if (Model.IsAdmin)
                        {
                            <div class="exercise-actions">

                                <a href="/Exercise/Update?id=@exercise.Id&mode=admin"
                                   class="btn btn-outline-success btn-sm">
                                    Düzenle
                                </a>

                                <a href="/Exercise/Delete?id=@exercise.Id&mode=admin"
                                   class="btn btn-outline-danger btn-sm">
                                    Sil
                                </a>

                            </div>
                        }

                    </div>

                </div>
            }

        </div>
    }

</div>

<style>

    .page-badge {
        color: #198754;
        background: #e8f5ee;
        padding: 7px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
    }

    .exercise-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 25px;
    }

    .exercise-card {
        background: white;
        border: 1px solid #e4ebe7;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0,0,0,.04);
    }

    .exercise-image,
    .exercise-placeholder {
        width: 100%;
        height: 210px;
        object-fit: cover;
    }

    .exercise-placeholder {
        background: #e8f5ee;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 48px;
    }

    .exercise-body {
        padding: 25px;
    }

        .exercise-body h3 {
            color: #263238;
        }

    .exercise-description {
        line-height: 1.6;
        min-height: 50px;
    }

    .category-badge {
        display: inline-block;
        margin-top: 8px;
        color: #198754;
        background: #e8f5ee;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .video-link {
        color: #198754;
        font-weight: 600;
        text-decoration: none;
    }

        .video-link:hover {
            text-decoration: underline;
        }

    .exercise-actions {
        display: flex;
        gap: 8px;
        margin-top: 20px;
        padding-top: 18px;
        border-top: 1px solid #edf1ee;
    }

    .empty-card {
        background: white;
        border: 1px dashed #cfd8d3;
        border-radius: 18px;
        padding: 60px;
        text-align: center;
    }

    .empty-icon {
        font-size: 40px;
    }

</style>