@page
@model Sporkocu.Web.Pages.Food.DeleteModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Besin Sil";
}

<div class="container py-5">

    <div class="card border-0 shadow-sm p-5 text-center"
         style="max-width:650px; margin:auto;">

        <div style="font-size:50px;" class="mb-3">
            ⚠️
        </div>

        <h2 class="fw-bold mb-3">
            Besini Sil
        </h2>

        <p class="text-muted mb-4">
            <strong>@Model.Food.Title</strong>
            isimli besini silmek istediğinize emin misiniz?
        </p>

        <form method="post">

            <input type="hidden"
                   asp-for="Food.Id" />

            <div class="d-flex justify-content-center gap-2">

                <button type="submit"
                        class="btn btn-danger px-4">
                    Evet, Sil
                </button>

                <a href="/Food/List?mode=admin"
                   class="btn btn-outline-secondary px-4">
                    Vazgeç
                </a>

            </div>

        </form>

    </div>

</div>