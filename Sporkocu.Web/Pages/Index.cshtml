@page
@model IndexModel

@{
    Layout = null;
    ViewData["Title"] = "SporKocu";
}

<!DOCTYPE html>
<html lang="tr">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>SporKocu</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                background: #f8f9fa;
                font-family: Arial, Helvetica, sans-serif;
                color: #212529;
            }

            /* NAVBAR */

            .navbar-custom {
                height: 75px;
                background: white;
                border-bottom: 1px solid #eeeeee;
            }

            .logo {
                font-size: 1.5rem;
                font-weight: 700;
                color: #212529;
                text-decoration: none;
            }

                .logo:hover {
                    color: #00a400;
                }

            .logo-icon {
                font-size: 1.7rem;
                margin-right: 8px;
            }

            .nav-link-custom {
                color: #555;
                text-decoration: none;
                margin-left: 25px;
                font-size: 0.95rem;
            }

                .nav-link-custom:hover {
                    color: #00a400;
                }

            .admin-link {
                color: #888;
                text-decoration: none;
                font-size: 0.8rem;
                margin-left: 25px;
            }

                .admin-link:hover {
                    color: #00a400;
                }


            /* HERO */

            .hero {
                min-height: calc(100vh - 75px);
                display: flex;
                align-items: center;
            }

            .hero-content {
                padding: 70px 0;
            }

            .hero-small-title {
                color: #00a400;
                font-size: 0.85rem;
                font-weight: 700;
                letter-spacing: 2px;
                margin-bottom: 18px;
            }

            .hero-title {
                font-size: 4.2rem;
                font-weight: 800;
                line-height: 1.08;
                letter-spacing: -2px;
            }

                .hero-title span {
                    color: #00a400;
                }

            .hero-description {
                color: #6c757d;
                font-size: 1.1rem;
                line-height: 1.7;
                max-width: 570px;
                margin-top: 25px;
            }

            .hero-buttons {
                margin-top: 35px;
            }

                .hero-buttons .btn {
                    padding: 12px 28px;
                    border-radius: 8px;
                    font-weight: 600;
                }


            /* YEŞİL BUTONLAR */

            .btn-success {
                background-color: #00a400;
                border-color: #00a400;
                color: white;
            }

                .btn-success:hover {
                    background-color: #008f00;
                    border-color: #008f00;
                    color: white;
                }

            .btn-outline-success {
                color: #00a400;
                border-color: #00a400;
            }

                .btn-outline-success:hover {
                    background-color: #00a400;
                    border-color: #00a400;
                    color: white;
                }


            /* SAĞ TARAF */

            .hero-visual {
                display: flex;
                justify-content: center;
                align-items: center;
            }

            .visual-box {
                width: 390px;
                height: 390px;
                background: white;
                border-radius: 35px;
                box-shadow: 0 20px 50px rgba(0, 0, 0, 0.08);
                display: flex;
                justify-content: center;
                align-items: center;
                position: relative;
            }

            .visual-circle {
                width: 250px;
                height: 250px;
                border-radius: 50%;
                background: #e8f5e9;
                display: flex;
                justify-content: center;
                align-items: center;
            }

            .visual-icon {
                font-size: 7rem;
            }

            .floating-card {
                position: absolute;
                background: white;
                padding: 15px 20px;
                border-radius: 12px;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
                font-size: 0.9rem;
                font-weight: 600;
            }

            .card-one {
                top: 35px;
                left: -25px;
            }

            .card-two {
                bottom: 35px;
                right: -25px;
            }


            /* ALT BİLGİLER */

            .features {
                padding: 70px 0;
                background: white;
            }

            .feature {
                text-align: center;
                padding: 20px;
            }

            .feature-icon {
                font-size: 2.3rem;
                margin-bottom: 15px;
            }

            .feature h4 {
                font-size: 1.1rem;
                font-weight: 700;
            }

            .feature p {
                color: #6c757d;
                font-size: 0.9rem;
                margin: 0 auto;
                max-width: 280px;
            }

    </style>

</head>


<body>


    <!-- NAVBAR -->

    <nav class="navbar-custom">

        <div class="container h-100">

            <div class="d-flex align-items-center
                justify-content-between h-100">

                <!-- Logo -->

                <a asp-page="/Index"
                   class="logo">

                    <span class="logo-icon">🏋️</span>
                    Spor Koçu

                </a>


                <!-- Menü -->

                <div class="d-flex align-items-center">

                    <a asp-page="/Login/Index"
                       class="nav-link-custom">

                        Giriş Yap

                    </a>


                    <a asp-page="/Register/Index"
                       class="nav-link-custom">

                        Kayıt Ol

                    </a>


                    <a asp-page="/Admin/Login/Index"
                       class="admin-link">

                        Admin

                    </a>

                </div>

            </div>

        </div>

    </nav>



    <!-- HERO -->

    <section class="hero">

        <div class="container">

            <div class="row align-items-center">


                <!-- SOL -->

                <div class="col-lg-7">

                    <div class="hero-content">

                        <div class="hero-small-title">

                            SPOR • BESLENME • SAĞLIKLI YAŞAM

                        </div>


                        <h1 class="hero-title">

                            Daha güçlü bir
                            <span>sen.</span>

                        </h1>


                        <p class="hero-description">

                            SporKocu ile egzersizlerini keşfet,
                            besinleri incele ve sağlıklı yaşam
                            yolculuğunu daha bilinçli bir şekilde
                            yönet.

                        </p>


                        <div class="hero-buttons">

                            <a asp-page="/Login/Index"
                               class="btn btn-success me-2">

                                Giriş Yap

                            </a>


                            <a asp-page="/Register/Index"
                               class="btn btn-outline-success">

                                Kayıt Ol

                            </a>

                        </div>

                    </div>

                </div>



                <!-- SAĞ -->

                <div class="col-lg-5">

                    <div class="hero-visual">

                        <div class="visual-box">


                            <div class="visual-circle">

                                <div class="visual-icon">

                                    🏋️

                                </div>

                            </div>


                            <div class="floating-card card-one">

                                🏃 Egzersiz

                            </div>


                            <div class="floating-card card-two">

                                🍎 Beslenme

                            </div>


                        </div>

                    </div>

                </div>


            </div>

        </div>

    </section>



    <!-- ÖZELLİKLER -->

    <section class="features">

        <div class="container">

            <div class="row">


                <div class="col-md-4">

                    <div class="feature">

                        <div class="feature-icon">
                            🏃
                        </div>

                        <h4>
                            Egzersizlerini Keşfet
                        </h4>

                        <p>
                            Farklı egzersizleri incele
                            ve kendine uygun aktiviteleri keşfet.
                        </p>

                    </div>

                </div>


                <div class="col-md-4">

                    <div class="feature">

                        <div class="feature-icon">
                            🍎
                        </div>

                        <h4>
                            Besinleri İncele
                        </h4>

                        <p>
                            Besinlerin özelliklerini ve
                            besin değerlerini öğren.
                        </p>

                    </div>

                </div>


                <div class="col-md-4">

                    <div class="feature">

                        <div class="feature-icon">
                            📝
                        </div>

                        <h4>
                            Bilgini Geliştir
                        </h4>

                        <p>
                            Sağlıklı yaşam hakkında
                            blog içeriklerini takip et.
                        </p>

                    </div>

                </div>


            </div>

        </div>

    </section>



    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>