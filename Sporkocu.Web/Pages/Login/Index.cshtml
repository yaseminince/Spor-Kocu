@page
@model Sporkocu.Web.Pages.Login.IndexModel

@{
    Layout = null;
    ViewData["Title"] = "Giriş Yap";
}

<!DOCTYPE html>
<html lang="tr">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Giriş Yap - SporKocu</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>

            body {
                margin: 0;
                background: #f8faf9;
                font-family: Arial, Helvetica, sans-serif;
            }

            .topbar {
                height: 75px;
                background: white;
                border-bottom: 1px solid #eeeeee;
            }

            .logo {
                color: #198754;
                text-decoration: none;
                font-size: 1.5rem;
                font-weight: 700;
            }

                .logo:hover {
                    color: #157347;
                }

            .back-link {
                color: #6c757d;
                text-decoration: none;
                font-size: 0.9rem;
            }

                .back-link:hover {
                    color: #198754;
                }

            .login-area {
                min-height: calc(100vh - 75px);
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .login-card {
                width: 430px;
                background: white;
                border-radius: 20px;
                padding: 45px;
                box-shadow: 0 15px 40px rgba(0, 0, 0, 0.08);
            }

            .login-icon {
                font-size: 3.5rem;
            }

            .login-title {
                font-weight: 700;
            }

            .form-control {
                height: 50px;
                border-radius: 8px;
            }

                .form-control:focus {
                    border-color: #198754;
                    box-shadow: 0 0 0 0.2rem rgba(25, 135, 84, 0.15);
                }

            .login-button {
                height: 50px;
                border-radius: 8px;
                font-weight: 600;
            }

    </style>

</head>


<body>


    <!-- Üst Menü -->

    <nav class="topbar">

        <div class="container h-100">

            <div class="d-flex
                align-items-center
                justify-content-between
                h-100">

                <a asp-page="/Index"
                   class="logo">

                    🏋️ SporKocu

                </a>

                <a asp-page="/Index"
                   class="back-link">

                    ← Ana Sayfa

                </a>

            </div>

        </div>

    </nav>


    <!-- Login -->

    <main class="login-area">

        <div class="login-card">

            <div class="text-center mb-4">

                <div class="login-icon">
                    🏋️
                </div>

                <h2 class="login-title mt-3">
                    Hoş Geldiniz
                </h2>

                <p class="text-muted">
                    SporKocu hesabınıza giriş yapın.
                </p>

            </div>


            <form method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger mb-3">
                        @Model.ErrorMessage
                    </div>
                }


                <div class="mb-3">

                    <label asp-for="Email"
                           class="form-label">
                        E-posta
                    </label>

                    <input asp-for="Email"
                           type="email"
                           class="form-control"
                           placeholder="E-posta adresiniz" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-4">

                    <label asp-for="Password"
                           class="form-label">
                        Şifre
                    </label>

                    <input asp-for="Password"
                           type="password"
                           class="form-control"
                           placeholder="Şifreniz" />

                    <span asp-validation-for="Password"
                          class="text-danger">
                    </span>

                </div>


                <div class="d-grid">

                    <button type="submit"
                            class="btn btn-success login-button">

                        Giriş Yap

                    </button>

                </div>

            </form>


            <div class="text-center mt-4">

                <span class="text-muted">
                    Hesabınız yok mu?
                </span>

                <a asp-page="/Register/Index"
                   class="text-success text-decoration-none fw-semibold">

                    Kayıt Ol

                </a>

            </div>

        </div>

    </main>


</body>

</html>