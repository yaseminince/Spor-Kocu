@page
@model Sporkocu.Web.Pages.UserDashboard.DashboardModel

@{
    Layout = null;
    ViewData["Title"] = "Dashboard";
}

<!DOCTYPE html>
<html lang="tr">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - SporKocu</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>

            body {
                margin: 0;
                background: #f6f8f7;
                color: #26332b;
                font-family: Arial, Helvetica, sans-serif;
            }


            /* NAVBAR */

            .dashboard-navbar {
                height: 70px;
                background: white;
                border-bottom: 1px solid #e5ebe7;
            }

            .dashboard-navbar-inner {
                max-width: 1200px;
                height: 100%;
                margin: 0 auto;
                padding: 0 20px;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .dashboard-logo {
                color: #2f7d4d;
                text-decoration: none;
                font-size: 22px;
                font-weight: 700;
                letter-spacing: 1px;
            }

                .dashboard-logo:hover {
                    color: #24643c;
                }

            .dashboard-navbar-right {
                display: flex;
                align-items: center;
                gap: 20px;
            }

            .profile-link {
                color: #37423b;
                text-decoration: none;
                font-size: 14px;
                font-weight: 500;
            }

                .profile-link:hover {
                    color: #2f7d4d;
                }

            .logout-link {
                color: #dc3545;
                text-decoration: none;
                font-size: 14px;
                font-weight: 600;
            }

                .logout-link:hover {
                    color: #b02a37;
                }


            /* DASHBOARD */

            .dashboard-container {
                max-width: 1200px;
                margin: 0 auto;
                padding: 45px 20px;
            }


            /* WELCOME */

            .welcome-card {
                background: linear-gradient(135deg, #2f7d4d, #3f9860);
                color: white;
                border-radius: 22px;
                padding: 35px;
                margin-bottom: 35px;
                box-shadow: 0 8px 25px rgba(47, 125, 77, .12);
            }

                .welcome-card h1 {
                    font-size: 30px;
                    font-weight: 700;
                    margin-bottom: 8px;
                }

                .welcome-card p {
                    margin: 0;
                    opacity: .88;
                    font-size: 15px;
                }


            /* CARDS */

            .dashboard-card {
                background: white;
                border: 1px solid #e5ebe7;
                border-radius: 18px;
                padding: 28px;
                height: 100%;
                transition: all .2s ease;
                box-shadow: 0 3px 12px rgba(0,0,0,.03);
            }

                .dashboard-card:hover {
                    transform: translateY(-4px);
                    box-shadow: 0 8px 22px rgba(0,0,0,.07);
                }

            .dashboard-icon {
                width: 52px;
                height: 52px;
                border-radius: 14px;
                background: #edf7f0;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 25px;
                margin-bottom: 18px;
            }

            .dashboard-card h3 {
                font-size: 20px;
                font-weight: 700;
                color: #17221c;
                margin-bottom: 8px;
            }

            .dashboard-card p {
                color: #78847d;
                font-size: 14px;
                line-height: 1.6;
                min-height: 45px;
                margin-bottom: 20px;
            }

            .dashboard-btn {
                color: #2f7d4d;
                text-decoration: none;
                font-weight: 600;
                font-size: 14px;
            }

                .dashboard-btn:hover {
                    color: #24643c;
                }

    </style>

</head>


<body>


    <!-- DASHBOARD NAVBAR -->

    <nav class="dashboard-navbar">

        <div class="dashboard-navbar-inner">

            <a asp-page="/UserDashboard/Dashboard"
               class="dashboard-logo">

                Spor Koçu

            </a>

            <div class="dashboard-navbar-right">

                <a href="/User/MyProfile"
                   class="profile-link">

                    Profilim

                </a>

                <a asp-page="/Index"
                   class="logout-link">

                    Çıkış Yap

                </a>

            </div>

        </div>

    </nav>


    <!-- DASHBOARD -->

    <div class="dashboard-container">


        <!-- HOŞ GELDİN -->

        <div class="welcome-card">

            <h1>
                Hoş geldin! 👋
            </h1>

            <p>
                Spor Koçu hesabından antrenmanlarını,
                beslenme planını ve koçunla iletişimini yönetebilirsin.
            </p>

        </div>


        <!-- KARTLAR -->

        <div class="row g-4">


            <!-- BLOG -->

            <div class="col-md-6 col-lg-4">

                <div class="dashboard-card">

                    <div class="dashboard-icon">
                        📝
                    </div>

                    <h3>
                        Blog
                    </h3>

                    <p>
                        Spor, beslenme ve sağlıklı yaşam
                        hakkında faydalı yazıları keşfet.
                    </p>

                    <a asp-page="/Blog/List"
                       class="dashboard-btn">

                        Blogları Gör →

                    </a>

                </div>

            </div>


            <!-- EGZERSİZLER -->

            <div class="col-md-6 col-lg-4">

                <div class="dashboard-card">

                    <div class="dashboard-icon">
                        🏃
                    </div>

                    <h3>
                        Egzersizler
                    </h3>

                    <p>
                        Sistemde bulunan egzersizleri
                        görüntüle ve incele.
                    </p>

                    <a asp-page="/Exercise/List"
                       class="dashboard-btn">

                        Egzersizlere Git →

                    </a>

                </div>

            </div>


            <!-- KOÇUM -->

            <div class="col-md-6 col-lg-4">

                <div class="dashboard-card">

                    <div class="dashboard-icon">
                        💬
                    </div>

                    <h3>
                        Koçum
                    </h3>

                    <p>
                        Koçunu görüntüle, sorularını takip et
                        ve cevaplarını incele.
                    </p>

                    <a asp-page="/Question/List"
                       class="dashboard-btn">

                        Koçuma Git →

                    </a>

                </div>

            </div>


            <!-- BESLENME -->

            <div class="col-md-6 col-lg-4">

                <div class="dashboard-card">

                    <div class="dashboard-icon">
                        🍎
                    </div>

                    <h3>
                        Beslenme Planım
                    </h3>

                    <p>
                        Sana özel hazırlanmış beslenme planını
                        ve öğünlerini görüntüle.
                    </p>

                    <a asp-page="/NutritionPlan/List"
                       class="dashboard-btn">

                        Planımı Gör →

                    </a>

                </div>

            </div>

            <!-- BESIN -->

            <div class="col-md-6 col-lg-4">
                <div class="dashboard-card">
                    <div class="dashboard-icon">🍎</div>

                    <h3>Besinler</h3>

                    <p>
                        Besinlerin kalori ve besin değerlerini incele.
                    </p>

                    <a asp-page="/Food/List"
                       class="dashboard-btn">
                        Besinlere Git →
                    </a>
                </div>
            </div>


            <!-- PROFİL -->

            <div class="col-md-6 col-lg-4">

                <div class="dashboard-card">

                    <div class="dashboard-icon">
                        👤
                    </div>

                    <h3>
                        Profilim
                    </h3>

                    <p>
                        Kişisel bilgilerini görüntüle
                        ve güncelle.
                    </p>

                    <a href="/User/MyProfile"
                       class="dashboard-btn">
                        Profilime Git →
                    </a>

                </div>

            </div>


        </div>

    </div>


    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>