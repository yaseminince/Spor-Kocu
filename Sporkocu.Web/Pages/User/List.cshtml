@page
@model Sporkocu.Web.Pages.User.ListModel

@{
    Layout = Model.IsAdmin ? "_AdminLayout" : "_UserLayout";
    ViewData["Title"] = "Kullanıcılar";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-5">

        <div>
            <h1 class="fw-bold mb-2">
                Kullanıcılar
            </h1>

            <p class="text-muted mb-0">
                Sistem kullanıcılarını buradan yönetebilirsiniz.
            </p>
        </div>

    </div>


    @if (!Model.Users.Any())
    {
        <div class="empty-card">
            <div class="empty-icon">
                👥
            </div>

            <h4 class="fw-bold mt-3">
                Henüz kullanıcı bulunmuyor.
            </h4>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm"
             style="border-radius: 18px; overflow: hidden;">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th>ID</th>
                            <th>Ad Soyad</th>
                            <th>Email</th>
                            <th>Telefon</th>
                            <th>Premium</th>

                            @if (Model.IsAdmin)
                            {
                                <th class="text-end">
                                    İşlemler
                                </th>
                            }

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var user in Model.Users)
                        {
                            <tr>

                                <td>
                                    @user.Id
                                </td>

                                <td class="fw-semibold">
                                    @user.FullName
                                </td>

                                <td>
                                    @user.Email
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(user.Phone)
                                        ? "-"
                                        : user.Phone)
                                </td>

                                <td>

                                    @if (user.PremiumPackage > 0)
                                    {
                                        <span class="badge bg-success">
                                            Premium
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Standart
                                        </span>
                                    }

                                </td>

                                @if (Model.IsAdmin)
                                {
                                    <td class="text-end">


                                        <a href="/User/Delete?id=@user.Id&mode=admin"
                                           class="btn btn-outline-danger btn-sm">
                                            Sil
                                        </a>

                                    </td>
                                }

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>


<style>

    .empty-card {
        background: white;
        border: 1px dashed #cfd8d3;
        border-radius: 18px;
        padding: 60px;
        text-align: center;
    }

    .empty-icon {
        font-size: 40px;
    }

    table th {
        font-size: 14px;
        color: #495057;
    }

    table td {
        padding: 18px 16px;
    }

</style>