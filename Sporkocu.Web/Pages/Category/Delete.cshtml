@page
@model Sporkocu.Web.Pages.Category.DeleteModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Kategori Sil";
}

<div class="container py-5">

    <div class="delete-wrapper">

        <div class="delete-icon">
            🗑️
        </div>

        <h1 class="fw-bold mt-4 mb-3">
            Kategoriyi Sil
        </h1>

        <p class="text-muted">
            Bu kategoriyi silmek istediğinize emin misiniz?
        </p>

        <div class="category-preview">

            <h4 class="fw-bold mb-2">
                @Model.Category.Title
            </h4>

            @if (!string.IsNullOrWhiteSpace(Model.Category.Description))
            {
                <p class="text-muted mb-0">
                    @Model.Category.Description
                </p>
            }

        </div>

        <form method="post">

            <input type="hidden"
                   name="mode"
                   value="admin" />

            <div class="d-flex justify-content-center gap-3 mt-4">

                <a href="/Category/List?mode=admin"
                   class="btn btn-light border px-4">
                    Vazgeç
                </a>

                <button type="submit"
                        class="btn btn-danger px-4">
                    Kategoriyi Sil
                </button>

            </div>

        </form>

    </div>

</div>

<style>

    .delete-wrapper {
        width: 600px;
        margin: 60px auto;
        background: white;
        border: 1px solid #e5e9e7;
        border-radius: 20px;
        padding: 45px;
        text-align: center;
        box-shadow: 0 6px 25px rgba(0,0,0,.05);
    }

    .delete-icon {
        width: 65px;
        height: 65px;
        margin: auto;
        border-radius: 50%;
        background: #fff0f0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
    }

    .category-preview {
        margin-top: 25px;
        padding: 20px;
        background: #f8faf9;
        border-radius: 12px;
        text-align: left;
    }

</style>