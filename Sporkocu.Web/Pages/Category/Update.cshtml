@page
@model Sporkocu.Web.Pages.Category.UpdateModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Kategori Düzenle";
}

<div class="container py-5">

    <div class="form-wrapper">

        <div class="mb-4">
            <span class="page-badge">KATEGORİ</span>

            <h1 class="fw-bold mt-3 mb-2">
                Kategoriyi Düzenle
            </h1>

            <p class="text-muted">
                Kategori bilgilerini güncelleyin.
            </p>
        </div>

        <form method="post">

            <input type="hidden"
                   asp-for="Category.Id" />

            <input type="hidden"
                   name="mode"
                   value="admin" />

            <div asp-validation-summary="All"
                 class="text-danger mb-3">
            </div>

            <div class="mb-4">

                <label asp-for="Category.Title"
                       class="form-label fw-semibold">
                    Kategori Adı
                </label>

                <input asp-for="Category.Title"
                       class="form-control" />

                <span asp-validation-for="Category.Title"
                      class="text-danger">
                </span>

            </div>

            <div class="mb-4">

                <label asp-for="Category.Description"
                       class="form-label fw-semibold">
                    Açıklama
                </label>

                <textarea asp-for="Category.Description"
                          class="form-control"
                          rows="5"></textarea>

                <span asp-validation-for="Category.Description"
                      class="text-danger">
                </span>

            </div>

            <div class="d-flex justify-content-between">

                <a href="/Category/List?mode=admin"
                   class="btn btn-light border">
                    ← Vazgeç
                </a>

                <button type="submit"
                        class="btn btn-success px-4">
                    Değişiklikleri Kaydet
                </button>

            </div>

        </form>

    </div>

</div>

<style>

    .form-wrapper {
        width: 720px;
        margin: 30px auto;
        background: white;
        border: 1px solid #e5e9e7;
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 6px 25px rgba(0,0,0,.05);
    }

    .page-badge {
        color: #198754;
        background: #e8f5ee;
        padding: 7px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
    }

    .form-control {
        padding: 12px 14px;
        border-radius: 10px;
    }

</style>