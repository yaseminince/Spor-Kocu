@page
@model Sporkocu.Web.Pages.NutritionPlan.DeleteModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Beslenme Planını Sil";
}

<div class="container py-5">

    <div class="card shadow-sm border-0"
         style="max-width: 700px; margin: auto; border-radius: 20px;">

        <div class="card-body p-5 text-center">

            <div style="font-size: 50px;">
                ⚠️
            </div>

            <h1 class="fw-bold mt-3">
                Beslenme Planını Sil
            </h1>

            <p class="text-muted mt-3">
                Bu beslenme planını silmek istediğinizden emin misiniz?
            </p>


            <div class="bg-light rounded-3 p-4 my-4">

                <h4 class="fw-bold mb-2">
                    @Model.NutritionPlan.Title
                </h4>

                @if (!string.IsNullOrWhiteSpace(Model.NutritionPlan.Description))
                {
                    <p class="text-muted mb-0">
                        @Model.NutritionPlan.Description
                    </p>
                }

            </div>


            <form method="post">

                <input type="hidden"
                       name="id"
                       value="@Model.NutritionPlan.Id" />

                <input type="hidden"
                       name="mode"
                       value="admin" />

                <div class="d-flex justify-content-center gap-2">

                    <a href="/NutritionPlan/List?mode=admin"
                       class="btn btn-outline-secondary">
                        Vazgeç
                    </a>

                    <button type="submit"
                            class="btn btn-danger">
                        Planı Sil
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>