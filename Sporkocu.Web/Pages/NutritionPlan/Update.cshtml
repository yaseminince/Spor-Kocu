@page
@model Sporkocu.Web.Pages.NutritionPlan.UpdateModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Beslenme Planını Düzenle";
}

<div class="container py-5">

    <div class="card shadow-sm border-0"
         style="max-width: 900px; margin: auto; border-radius: 20px;">

        <div class="card-body p-5">

            <h1 class="fw-bold mb-2">
                Beslenme Planını Düzenle
            </h1>

            <p class="text-muted mb-4">
                Beslenme planının bilgilerini güncelleyin.
            </p>

            <form method="post">

                <input type="hidden"
                       asp-for="NutritionPlan.Id" />

                <input type="hidden"
                       name="mode"
                       value="admin" />


                <div class="mb-4">

                    <label class="form-label fw-bold">
                        Plan Başlığı
                    </label>

                    <input asp-for="NutritionPlan.Title"
                           class="form-control" />

                </div>


                <div class="mb-4">

                    <label class="form-label fw-bold">
                        Açıklama
                    </label>

                    <textarea asp-for="NutritionPlan.Description"
                              class="form-control"
                              rows="5"></textarea>

                </div>


                <div class="d-flex justify-content-end gap-2">

                    <a href="/NutritionPlan/List?mode=admin"
                       class="btn btn-outline-secondary">
                        Vazgeç
                    </a>

                    <button type="submit"
                            class="btn btn-success">
                        Değişiklikleri Kaydet
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>