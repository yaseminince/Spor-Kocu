@page
@model Sporkocu.Web.Pages.NutritionPlan.CreateModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Yeni Beslenme Planı";
}

<div class="container py-5">

    <div class="card shadow-sm border-0"
         style="max-width: 900px; margin: auto; border-radius: 20px;">

        <div class="card-body p-5">

            <h1 class="fw-bold mb-2">
                Yeni Beslenme Planı
            </h1>

            <p class="text-muted mb-4">
                Sisteme yeni bir beslenme planı ekleyin.
            </p>

            <form method="post">

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <input type="hidden"
                       name="mode"
                       value="admin" />

                <div class="mb-4">

                    <label class="form-label fw-bold">
                        Plan Başlığı
                    </label>

                    <input asp-for="NutritionPlan.Title"
                           class="form-control"
                           placeholder="Örneğin: Low Carb Diyet Planı" />

                </div>


                <div class="mb-4">

                    <label class="form-label fw-bold">
                        Açıklama
                    </label>

                    <textarea asp-for="NutritionPlan.Description"
                              class="form-control"
                              rows="5"
                              placeholder="Beslenme planı hakkında kısa bir açıklama..."></textarea>

                </div>


                <div class="d-flex justify-content-end gap-2">

                    <a href="/NutritionPlan/List?mode=admin"
                       class="btn btn-outline-secondary">
                        Vazgeç
                    </a>

                    <button type="submit"
                            class="btn btn-success">
                        Planı Kaydet
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>