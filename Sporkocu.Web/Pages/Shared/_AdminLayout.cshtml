<!DOCTYPE html>
<html lang="tr">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - SporKocu Admin
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>

            body {
                background-color: #f5f6f7;
                color: #212529;
                font-family: Arial, sans-serif;
            }

            .navbar {
                min-height: 70px;
            }

            .navbar-brand {
                font-size: 22px;
                letter-spacing: 1px;
            }

            .nav-link {
                color: #d8dadd !important;
                margin-left: 12px;
                font-weight: 500;
            }

                .nav-link:hover {
                    color: white !important;
                }

            main {
                padding-top: 10px;
                padding-bottom: 40px;
            }

    </style>

</head>


<body>

    <nav class="navbar navbar-expand-lg bg-dark">

        <div class="container">

            <a class="navbar-brand fw-bold text-white"
               href="/Admin/Dashboard">
                SPORKOCU
            </a>


            <div class="navbar-nav ms-auto align-items-center">

                <a class="nav-link"
                   href="/Admin/Dashboard">
                    Dashboard
                </a>

                <a class="nav-link"
                   href="/User/List?mode=admin">
                    Kullanıcılar
                </a>

                <a class="nav-link"
                   href="/Category/List?mode=admin">
                    Kategoriler
                </a>

                <a class="nav-link"
                   href="/Exercise/List?mode=admin">
                    Egzersizler
                </a>

                <a class="nav-link"
                   href="/Food/List?mode=admin">
                    Besinler
                </a>

                <a class="nav-link"
                   href="/Blog/List?mode=admin">
                    Bloglar
                </a>

                <a class="nav-link"
                   href="/Question/List?mode=admin">
                    Sorular
                </a>


                <a class="nav-link"
                   href="/NutritionPlan/List?mode=admin">
                    Beslenme Planları
                </a>

                <a class="btn btn-outline-light btn-sm ms-3"
                   href="/Index">
                    Çıkış Yap
                </a>

            </div>

        </div>

    </nav>


    <main>

        @RenderBody()

    </main>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>