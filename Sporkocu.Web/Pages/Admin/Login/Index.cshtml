@page
@model Sporkocu.Web.Pages.Admin.Login.IndexModel

@{
    Layout = null;
    ViewData["Title"] = "Admin Girişi";
}

<!DOCTYPE html>
<html lang="tr">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Admin Girişi - SporKocu</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>

            body {
                margin: 0;
                background: #f1f3f5;
                font-family: Arial, Helvetica, sans-serif;
            }

            .topbar {
                height: 75px;
                background: #212529;
            }

            .logo {
                color: white;
                text-decoration: none;
                font-size: 1.5rem;
                font-weight: 700;
            }

            .back-link {
                color: #adb5bd;
                text-decoration: none;
                font-size: 0.9rem;
            }

                .back-link:hover {
                    color: white;
                }

            .admin-area {
                min-height: calc(100vh - 75px);
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .admin-card {
                width: 430px;
                background: white;
                border-radius: 20px;
                padding: 45px;
                box-shadow: 0 15px 40px rgba(0, 0, 0, 0.08);
            }

            .admin-icon {
                font-size: 3.5rem;
            }

            .admin-title {
                font-weight: 700;
            }

            .form-control {
                height: 50px;
                border-radius: 8px;
            }

            .admin-button {
                height: 50px;
                border-radius: 8px;
                font-weight: 600;
            }

    </style>

</head>


<body>


    <!-- Navbar -->

    <nav class="topbar">

        <div class="container h-100">

            <div class="d-flex
                align-items-center
                justify-content-between
                h-100">

                <a asp-page="/Index"
                   class="logo">

                    🏋️ Spor Koçu

                </a>

                <a asp-page="/Index"
                   class="back-link">

                    ← Ana Sayfa

                </a>

            </div>

        </div>

    </nav>


    <!-- Admin Login -->

    <main class="admin-area">

        <div class="admin-card">

            <div class="text-center mb-4">

                <div class="admin-icon">
                    🔐
                </div>

                <h2 class="admin-title mt-3">
                    Admin Girişi
                </h2>

                <p class="text-muted">
                    Spor Koçu yönetim paneline giriş yapın.
                </p>

            </div>


            <form method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="mb-3">

                    <label asp-for="Email"
                           class="form-label">
                        E-posta
                    </label>

                    <input asp-for="Email"
                           type="email"
                           class="form-control"
                           placeholder="Admin e-posta adresi" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-4">

                    <label asp-for="Password"
                           class="form-label">
                        Şifre
                    </label>

                    <input asp-for="Password"
                           type="password"
                           class="form-control"
                           placeholder="Admin şifresi" />

                    <span asp-validation-for="Password"
                          class="text-danger">
                    </span>

                </div>


                <div class="d-grid">

                    <button type="submit"
                            class="btn btn-dark admin-button">

                        Admin Girişi

                    </button>

                </div>

            </form>


            <div class="text-center mt-4">

                <a asp-page="/Login/Index"
                   class="text-muted text-decoration-none">

                    Kullanıcı girişine dön

                </a>

            </div>

        </div>

    </main>


</body>

</html>