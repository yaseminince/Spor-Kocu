@page
@model Sporkocu.Web.Pages.Register.IndexModel

@{
    Layout = null;
    ViewData["Title"] = "Kayıt Ol";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Kayıt Ol - SporKocu</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
            body {
                background-color: #f8faf9;
                color: #263238;
                font-family: Arial, sans-serif;
            }

            .register-wrapper {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 40px;
            }

            .register-card {
                width: 850px;
                background: white;
                border-radius: 18px;
                padding: 40px;
                box-shadow: 0 10px 35px rgba(0,0,0,0.08);
            }

            .brand {
                color: #198754;
                font-size: 28px;
                font-weight: bold;
                letter-spacing: 2px;
                text-align: center;
            }

            .subtitle {
                text-align: center;
                color: #6c757d;
                margin-bottom: 30px;
            }

            .form-label {
                font-weight: 600;
            }

            .avatar-grid {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 15px;
            }

            .avatar-option input {
                display: none;
            }

            .avatar-card {
                border: 2px solid #e9ecef;
                border-radius: 14px;
                padding: 10px;
                text-align: center;
                cursor: pointer;
                transition: 0.2s;
            }

                .avatar-card:hover {
                    border-color: #198754;
                }

                .avatar-card img {
                    width: 100px;
                    height: 100px;
                    object-fit: cover;
                    border-radius: 50%;
                }

            .avatar-name {
                margin-top: 8px;
                font-weight: 600;
            }

            .avatar-option input:checked + .avatar-card {
                border-color: #198754;
                background-color: #f0fff7;
                box-shadow: 0 0 0 2px rgba(25, 135, 84, 0.12);
            }

            .register-btn {
                width: 100%;
                padding: 12px;
                font-size: 16px;
                font-weight: 600;
            }

            .login-link {
                text-align: center;
                margin-top: 20px;
            }
    </style>
</head>

<body>

    <div class="register-wrapper">

        <div class="register-card">

            <div class="brand">
                SPORKOCU
            </div>

            <p class="subtitle">
                Hesabını oluştur ve SporKocu'ya katıl.
            </p>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">
                    @Model.ErrorMessage
                </div>
            }

            <form method="post">

                <div class="mb-3">
                    <label asp-for="FullName"
                           class="form-label">
                        Ad Soyad
                    </label>

                    <input asp-for="FullName"
                           class="form-control"
                           placeholder="Adınız ve soyadınız" />
                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="Email"
                               class="form-label">
                            Email
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               placeholder="ornek@email.com" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Phone"
                               class="form-label">
                            Telefon
                        </label>

                        <input asp-for="Phone"
                               class="form-control"
                               placeholder="05XX XXX XX XX" />
                    </div>

                </div>

                <div class="mb-3">
                    <label asp-for="Address"
                           class="form-label">
                        Adres
                    </label>

                    <textarea asp-for="Address"
                              class="form-control"
                              rows="3"
                              placeholder="Adresiniz"></textarea>
                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="Password"
                               class="form-label">
                            Şifre
                        </label>

                        <input asp-for="Password"
                               type="password"
                               class="form-control"
                               placeholder="Şifreniz" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="PasswordAgain"
                               class="form-label">
                            Şifre Tekrar
                        </label>

                        <input asp-for="PasswordAgain"
                               type="password"
                               class="form-control"
                               placeholder="Şifrenizi tekrar girin" />
                    </div>

                </div>

                <div class="mb-4">

                    <label class="form-label">
                        Avatarını Seç
                    </label>

                    <div class="avatar-grid">

                        <label class="avatar-option">
                            <input type="radio"
                                   name="ProfilePicPath"
                                   value="/images/avatars/avatar-sandy.jpg"
                            @(Model.ProfilePicPath == "/images/avatars/avatar-sandy.jpg"
                                ? "checked"
                                : "") />

                            <div class="avatar-card">
                                <img src="/images/avatars/avatar-sandy.jpg"
                                     alt="Sandy" />
                                <div class="avatar-name">
                                    Sandy
                                </div>
                            </div>
                        </label>

                        <label class="avatar-option">
                            <input type="radio"
                                   name="ProfilePicPath"
                                   value="/images/avatars/avatar-spongebob.jpg"
                            @(Model.ProfilePicPath == "/images/avatars/avatar-spongebob.jpg"
                                ? "checked"
                                : "") />

                            <div class="avatar-card">
                                <img src="/images/avatars/avatar-spongebob.jpg"
                                     alt="SpongeBob" />
                                <div class="avatar-name">
                                    SpongeBob
                                </div>
                            </div>
                        </label>

                        <label class="avatar-option">
                            <input type="radio"
                                   name="ProfilePicPath"
                                   value="/images/avatars/avatar-squidward.jpg"
                            @(Model.ProfilePicPath == "/images/avatars/avatar-squidward.jpg"
                                ? "checked"
                                : "") />

                            <div class="avatar-card">
                                <img src="/images/avatars/avatar-squidward.jpg"
                                     alt="Squidward" />
                                <div class="avatar-name">
                                    Squidward
                                </div>
                            </div>
                        </label>

                        <label class="avatar-option">
                            <input type="radio"
                                   name="ProfilePicPath"
                                   value="/images/avatars/avatar-patrick.jpg"
                            @(Model.ProfilePicPath == "/images/avatars/avatar-patrick.jpg"
                                ? "checked"
                                : "") />

                            <div class="avatar-card">
                                <img src="/images/avatars/avatar-patrick.jpg"
                                     alt="Patrick" />
                                <div class="avatar-name">
                                    Patrick
                                </div>
                            </div>
                        </label>

                    </div>

                </div>

                <button type="submit"
                        class="btn btn-success register-btn">
                    Kayıt Ol
                </button>

            </form>

            <div class="login-link">
                Zaten hesabın var mı?
                <a asp-page="/Login/Index"
                   class="text-success fw-semibold">
                    Giriş Yap
                </a>
            </div>

        </div>

    </div>

</body>
</html>