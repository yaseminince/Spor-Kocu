@page
@model Sporkocu.Web.Pages.Blog.UpdateModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Blog Güncelle";
}

<div class="container py-4">

    <div class="mb-4">
        <h1 class="fw-bold">Blog Güncelle</h1>
        <p class="text-muted">
            Blog yazısının bilgilerini düzenleyin.
        </p>
    </div>

    <div class="card border-0 shadow-sm p-4">

        <form method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <input type="hidden"
                   asp-for="Blog.Id" />

            <div class="mb-3">
                <label asp-for="Blog.Title"
                       class="form-label fw-semibold">
                    Başlık
                </label>

                <input asp-for="Blog.Title"
                       class="form-control" />

                <span asp-validation-for="Blog.Title"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Blog.SubTitle"
                       class="form-label fw-semibold">
                    Alt Başlık
                </label>

                <input asp-for="Blog.SubTitle"
                       class="form-control" />

                <span asp-validation-for="Blog.SubTitle"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Blog.CategoryId"
                       class="form-label fw-semibold">
                    Kategori
                </label>

                <select asp-for="Blog.CategoryId"
                        class="form-select">

                    <option value="0">
                        Kategori seçiniz
                    </option>

                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Id">
                            @category.Title
                        </option>
                    }

                </select>

                <span asp-validation-for="Blog.CategoryId"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Blog.CoverImagePath"
                       class="form-label fw-semibold">
                    Kapak Görseli
                </label>

                <input asp-for="Blog.CoverImagePath"
                       class="form-control" />

                <span asp-validation-for="Blog.CoverImagePath"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-4">
                <label asp-for="Blog.HtmlContent"
                       class="form-label fw-semibold">
                    İçerik
                </label>

                <textarea asp-for="Blog.HtmlContent"
                          class="form-control"
                          rows="12"></textarea>

                <span asp-validation-for="Blog.HtmlContent"
                      class="text-danger">
                </span>
            </div>

            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary px-4">
                    Güncelle
                </button>

                <a href="/Blog/List?mode=admin"
                   class="btn btn-outline-secondary">
                    İptal
                </a>

            </div>

        </form>

    </div>
</div>