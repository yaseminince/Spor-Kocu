@page
@model Sporkocu.Web.Pages.Blog.CreateModel

@{
    ViewData["Title"] = "Yeni Blog Oluştur";
    Layout = "_AdminLayout";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Yeni Blog Oluştur</h2>
            <p class="text-muted mb-0">
                Yeni bir blog yazısı oluştur.
            </p>
        </div>

        <a href="/Blog/List?mode=admin"
           class="btn btn-secondary">
            ← Bloglara Dön
        </a>
    </div>

    <form method="post">

        <div asp-validation-summary="All"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Blog.Title"
                   class="form-label">
                Başlık
            </label>

            <input asp-for="Blog.Title"
                   class="form-control"
                   placeholder="Blog başlığını giriniz" />

            <span asp-validation-for="Blog.Title"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Blog.SubTitle"
                   class="form-label">
                Alt Başlık
            </label>

            <input asp-for="Blog.SubTitle"
                   class="form-control"
                   placeholder="Blog alt başlığını giriniz" />

            <span asp-validation-for="Blog.SubTitle"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Blog.CategoryId"
                   class="form-label">
                Kategori
            </label>

            <select asp-for="Blog.CategoryId"
                    class="form-select">

                <option value="">Kategori Seçiniz</option>

                @foreach (var category in Model.Categories)
                {
                    <option value="@category.Id">
                        @category.Title
                    </option>
                }

            </select>

            <span asp-validation-for="Blog.CategoryId"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Blog.CoverImagePath"
                   class="form-label">
                Kapak Görseli
            </label>

            <input asp-for="Blog.CoverImagePath"
                   class="form-control"
                   placeholder="Görsel URL'sini giriniz" />

            <span asp-validation-for="Blog.CoverImagePath"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Blog.HtmlContent"
                   class="form-label">
                İçerik
            </label>

            <textarea asp-for="Blog.HtmlContent"
                      class="form-control"
                      rows="10"
                      placeholder="Blog içeriğini giriniz"></textarea>

            <span asp-validation-for="Blog.HtmlContent"
                  class="text-danger"></span>
        </div>

        <div class="mt-4">

            <button type="submit"
                    class="btn btn-primary">
                Blogu Kaydet
            </button>

            <a href="/Blog/List?mode=admin"
               class="btn btn-secondary ms-2">
                Vazgeç
            </a>

        </div>

    </form>

</div>