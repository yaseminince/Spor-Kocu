@page "{id:int}"
@model Sporkocu.Web.Pages.Question.UpdateModel

<form method="post">

    <input asp-for="Question.Id" hidden />

    <div class="mb-3">
        <label>Başlık</label>
        <input asp-for="Question.Title"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Açıklama</label>
        <textarea asp-for="Question.Description"
                  class="form-control"></textarea>
    </div>

    <button type="submit"
            class="btn btn-warning">
        Güncelle
    </button>

</form>