@page
@model Sporkocu.Web.Pages.Question.ListModel

@{
    ViewData["Title"] = Model.IsAdmin ? "Sorular" : "Koçum";
    Layout = Model.IsAdmin ? "_AdminLayout" : "_UserLayout";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>
                @(Model.IsAdmin ? "Soru Yönetimi" : "Koçum")
            </h2>

            <p class="text-muted mb-0">
                @(Model.IsAdmin
                    ? "Kullanıcıların sorularını ve cevaplarını yönet."
                    : "Koçuna sorularını ilet ve cevaplarını takip et.")
            </p>
        </div>

        @if (!Model.IsAdmin)
        {
            <a href="/Question/Create"
               class="btn btn-success">
                + Yeni Soru Sor
            </a>
        }

    </div>


    @if (Model.Questions.Any())
    {
        @foreach (var question in Model.Questions)
        {
            var answer = Model.Answers
                .FirstOrDefault(x => x.QuestionId == question.Id);

            <div class="card mb-4 shadow-sm">

                <div class="card-body">

                    <h4 class="card-title">
                        @question.Title
                    </h4>

                    <p class="card-text text-muted">
                        @question.Description
                    </p>


                    @if (answer != null)
                    {
                        <!-- CEVAP VAR -->
                        <div class="mt-4 p-3 bg-light rounded">

                            <strong>Cevap:</strong>

                            <p class="mb-0 mt-2">
                                @answer.Description
                            </p>

                        </div>

                        @if (Model.IsAdmin)
                        {
                            <!-- ADMIN: CEVAPLANMIŞ SORUYU DA SİLEBİLİR -->
                            <div class="mt-3">

                                <a href="/Question/Delete?id=@question.Id&mode=admin"
                                   class="btn btn-outline-danger btn-sm">
                                    Sil
                                </a>

                            </div>
                        }
                    }
                    else
                    {
                        <!-- CEVAP YOK -->
                        <div class="mt-4">

                            <span class="badge bg-warning text-dark">
                                Henüz cevaplanmadı
                            </span>

                        </div>


                        @if (Model.IsAdmin)
                        {
                            <!-- ADMIN: CEVAP VER + SİL -->
                            <div class="mt-3 d-flex gap-2">

                                <a href="/Answer/Create?questionId=@question.Id&mode=admin"
                                   class="btn btn-success btn-sm">
                                    Cevap Ver
                                </a>

                                <a href="/Question/Delete?id=@question.Id&mode=admin"
                                   class="btn btn-outline-danger btn-sm">
                                    Sil
                                </a>

                            </div>
                        }
                        else
                        {
                            <!-- USER: SADECE KENDİ CEVAPSIZ SORUSUNU SİLEBİLİR -->
                            <div class="mt-3">

                                <a href="/Question/Delete?id=@question.Id"
                                   class="btn btn-outline-danger btn-sm">
                                    Sil
                                </a>

                            </div>
                        }
                    }

                </div>

            </div>
        }
    }
    else
    {
        <div class="alert alert-info">
            Henüz bir soru bulunmuyor.
        </div>
    }

</div>