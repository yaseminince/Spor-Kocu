@page
@model Sporkocu.Web.Pages.Question.CreateModel

@{
    Layout = "_UserLayout";
    ViewData["Title"] = "Yeni Soru";
}

<div class="container py-4">

    <div class="mb-4">
        <h1 class="fw-bold">Yeni Soru Sor</h1>

        <p class="text-muted">
            Koçunuza iletmek istediğiniz soruyu aşağıdaki formdan oluşturabilirsiniz.
        </p>
    </div>

    <div class="card border-0 shadow-sm p-4"
         style="max-width:850px;">

        <form method="post">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            <div class="mb-4">
                <label asp-for="Question.Title"
                       class="form-label fw-semibold">
                    Soru Başlığı
                </label>

                <input asp-for="Question.Title"
                       class="form-control"
                       placeholder="Örn. Beslenme programım hakkında bir sorum var" />

                <span asp-validation-for="Question.Title"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-4">
                <label asp-for="Question.Description"
                       class="form-label fw-semibold">
                    Sorunuz
                </label>

                <textarea asp-for="Question.Description"
                          class="form-control"
                          rows="7"
                          placeholder="Sorunuzu detaylı bir şekilde açıklayın..."></textarea>

                <span asp-validation-for="Question.Description"
                      class="text-danger">
                </span>
            </div>

            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-success px-4">
                    Soruyu Gönder
                </button>

                <a href="/Question/List"
                   class="btn btn-outline-secondary">
                    Vazgeç
                </a>

            </div>

        </form>

    </div>

</div>